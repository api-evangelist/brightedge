n":"Account ID","title":"A"},"description":"Account ID"},{"name":"t","in":"query","required":false,"schema":{"type":"string","description":"Tool name","default":"","title":"T"},"description":"Tool name"},{"name":"s","in":"query","required":false,"schema":{"type":"string","description":"LLM source","default":"","title":"S"},"description":"LLM source"},{"name":"sid","in":"query","required":false,"schema":{"type":"string","description":"Session ID","default":"","title":"Sid"},"description":"Session ID"},{"name":"pid","in":"query","required":false,"schema":{"type":"string","description":"Prompt ID (matches prompts_log.prompt_id)","default":"","title":"Pid"},"description":"Prompt ID (matches prompts_log.prompt_id)"},{"name":"r","in":"query","required":false,"schema":{"type":"string","description":"Feedback: like or dislike","default":"","title":"R"},"description":"Feedback: like or dislike"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/feedback/details":{"post":{"summary":"Save Feedback Details Endpoint","description":"Persist the user's free-text follow-up to a dislike feedback.","operationId":"save_feedback_details_endpoint_feedback_details_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/oauth/login":{"get":{"summary":"Auth Login","description":"Step 1 — call this to get a one-time Auth0 login URL.\nOpen the returned login_url in a browser, sign in with your BrightEdge\ncredentials, and /auth/callback will display your token as JSON.\nThe URL is valid for 10 minutes.","operationId":"auth_login_oauth_login_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/auth/login":{"get":{"summary":"Auth Login","description":"Step 1 — call this to get a one-time Au